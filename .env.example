# Copy this file to .env.local and replace the placeholder with your Gemini key.
GEMINI_API_KEY=your_gemini_api_key

# Local development uses /api/mcp on the same server automatically.
# For deployment, set MCP_SERVER_URL to the full URL of your MCP endpoint.
# MCP_SERVER_URL=https://your-app.example/api/mcp

# Optional local port (default: 3000).
# PORT=3000
